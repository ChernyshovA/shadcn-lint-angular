{
  "name": "shadcn-lint-angular",
  "version": "0.1.2",
  "description": "@shadcn/lint with Angular template support: a programmable agent-first linter for Tailwind design systems.",
  "license": "MIT",
  "author": {
    "name": "ChernyshovA",
    "url": "https://github.com/ChernyshovA"
  },
  "contributors": [
    {
      "name": "shadcn",
      "url": "https://twitter.com/shadcn"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChernyshovA/shadcn-lint-angular.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/ChernyshovA/shadcn-lint-angular#readme",
  "bugs": {
    "url": "https://github.com/ChernyshovA/shadcn-lint-angular/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/tailwind-worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node -e \"const fs=require('fs');fs.rmSync('README.md',{force:true});fs.rmSync('LICENSE',{force:true})\"",
    "test:types": "node scripts/smoke-types.mjs"
  },
  "keywords": [
    "shadcn",
    "angular",
    "angular-eslint",
    "spartan",
    "lint",
    "eslint",
    "oxlint",
    "tailwind",
    "tailwindcss",
    "design-system",
    "cn"
  ],
  "dependencies": {
    "@eslint/core": "^0.17.0",
    "@eslint/core-v1": "npm:@eslint/core@^1.2.1",
    "cn": "0.4.0"
  },
  "peerDependencies": {
    "@angular-eslint/bundled-angular-compiler": ">=19.0.0",
    "@typescript-eslint/parser": ">=8.40.0",
    "eslint": ">=9.30.0"
  },
  "peerDependenciesMeta": {
    "@angular-eslint/bundled-angular-compiler": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/bundled-angular-compiler": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@tailwindcss/node": "^4.3.4",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.33.0",
    "oxlint": "^1.91.0",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.13.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "optionalDependencies": {
    "oxc-parser": "^0.148.0"
  }
}
